<Project>

  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <!-- The single place the app version lives. scripts/build-release.ps1 reads it too. -->
    <Version>1.1.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Any compiler warning fails the build, so a mistake can't slip through unnoticed. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
