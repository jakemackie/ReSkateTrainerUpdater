<Project>

  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <!-- The single place the app version lives. scripts/build-release.ps1 reads it too. -->
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
