<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A plain console runner, so the tests need no extra packages and run anywhere .NET 8 does:
      dotnet run (project: tests/ReSkateTrainerUpdater.Tests)
    It exits with a non-zero code if any check fails, which is what CI looks at.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ReSkateTrainerUpdater.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReSkateTrainerUpdater.Core\ReSkateTrainerUpdater.Core.csproj" />
  </ItemGroup>

</Project>
