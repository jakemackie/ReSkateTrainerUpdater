<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ReSkateTrainerUpdater</RootNamespace>

    <!-- The exe people download. -->
    <AssemblyName>ReSkateTrainerUpdater</AssemblyName>
    <Product>ReSkate Trainer Updater</Product>
    <Description>Installs the newest ReSkate Trainer into your ReSkate folder.</Description>
    <ApplicationIcon>Assets\ReSkateTrainerUpdater.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded, so the window and header can show the same icon. LogicalName must match AppIcon. -->
    <EmbeddedResource Include="Assets\ReSkateTrainerUpdater.ico" LogicalName="app.ico" />

    <!-- The background photo, the same one the ReSkate launcher uses. See THIRD-PARTY-NOTICES.md. Delete this line and
         Assets\background.jpg to remove it: the window then falls back to a painted backdrop. LogicalName must match Backdrop. -->
    <EmbeddedResource Include="Assets\background.jpg" LogicalName="background.jpg" />

    <!-- The creator's profile picture, shown on the credit card. LogicalName must match AppImages. -->
    <EmbeddedResource Include="Assets\os_uk.png" LogicalName="profile.png" />

    <!-- The same fonts the ReSkate launcher uses. Licences are in THIRD-PARTY-NOTICES.md. LogicalNames must match GameFonts. -->
    <EmbeddedResource Include="Assets\Fonts\PermanentMarker-Regular.ttf" LogicalName="font.permanentmarker" />
    <EmbeddedResource Include="Assets\Fonts\Montserrat-ExtraBold.ttf" LogicalName="font.montserrat-extrabold" />
    <EmbeddedResource Include="Assets\Fonts\Montserrat-SemiBold.ttf" LogicalName="font.montserrat-semibold" />
  </ItemGroup>

  <!-- Trimming (build-release.ps1 -Trim) takes the exe from about 70 MB to about 30 MB, but Microsoft does not support trimming
       WinForms, and it does not work yet: the window can't take a dropped zip (TypeLoadException, then a crash with COM
       switched on). It is OFF for releases. These settings only let an experiment get as far as running; the exe's
       self-test (SelfTest.cs) is what shows whether it works. -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <!-- Trimming turns COM interop off by default, and a file dragged in from Explorer arrives as a COM object. Without
         this the window throws a TypeLoadException the moment a zip is dropped on it. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="System.Windows.Forms" />
    <TrimmerRootAssembly Include="System.Windows.Forms.Primitives" />
    <TrimmerRootAssembly Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReSkateTrainerUpdater.Core\ReSkateTrainerUpdater.Core.csproj" />
  </ItemGroup>

</Project>
