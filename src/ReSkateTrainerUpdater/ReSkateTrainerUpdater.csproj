<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ReSkateTrainerUpdater</RootNamespace>

    <!-- The exe people download. -->
    <AssemblyName>ReSkateTrainerUpdater</AssemblyName>
    <Product>ReSkate Trainer Updater</Product>
    <Description>Installs the newest ReSkate Trainer into your ReSkate folder.</Description>
    <ApplicationIcon>Assets\ReSkateTrainerUpdater.ico</ApplicationIcon>
    <!-- Only SelfTest uses it, to call the window's drop target through its vtable the way Explorer does. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The self-contained exe carries the whole Windows Desktop runtime, and most of it is WPF, which this WinForms app never
       uses. These files are left out of the release, whole: no code inside the files that stay is changed (unlike trimming).
       Each one is something nothing the app runs refers to; the exe's self-test loads every assembly the app refers to,
       directly or through the framework, and fails if one is missing. Small facade assemblies stay, because old type names
       can be resolved through them by name. Don't add an assembly that WinForms, System.Drawing or the app references. -->
  <ItemGroup>
    <!-- WPF, its themes and native parts, and WPF-only UI Automation. WinForms has its own accessibility (Accessibility.dll stays). -->
    <UnusedFrameworkFile Include="PresentationFramework.dll;PresentationCore.dll;WindowsBase.dll;System.Xaml.dll;PresentationUI.dll" />
    <UnusedFrameworkFile Include="PresentationFramework.Aero.dll;PresentationFramework.Aero2.dll;PresentationFramework.AeroLite.dll" />
    <UnusedFrameworkFile Include="PresentationFramework.Classic.dll;PresentationFramework.Luna.dll;PresentationFramework.Royale.dll" />
    <UnusedFrameworkFile Include="PresentationFramework-SystemCore.dll;PresentationFramework-SystemData.dll;PresentationFramework-SystemDrawing.dll" />
    <UnusedFrameworkFile Include="PresentationFramework-SystemXml.dll;PresentationFramework-SystemXmlLinq.dll" />
    <UnusedFrameworkFile Include="ReachFramework.dll;System.Printing.dll;System.IO.Packaging.dll;System.Windows.Controls.Ribbon.dll" />
    <UnusedFrameworkFile Include="System.Windows.Input.Manipulations.dll;System.Windows.Presentation.dll;WindowsFormsIntegration.dll;DirectWriteForwarder.dll" />
    <UnusedFrameworkFile Include="UIAutomationClient.dll;UIAutomationClientSideProviders.dll;UIAutomationProvider.dll;UIAutomationTypes.dll" />
    <UnusedFrameworkFile Include="D3DCompiler_47_cor3.dll;PenImc_cor3.dll;PresentationNative_cor3.dll;vcruntime140_cor3.dll;wpfgfx_cor3.dll" />
    <!-- The WinForms designer (Visual Studio only) and Visual Basic. -->
    <UnusedFrameworkFile Include="System.Windows.Forms.Design.dll;Microsoft.VisualBasic.Core.dll;Microsoft.VisualBasic.Forms.dll" />
    <!-- Other parts of .NET the app has no use for. -->
    <UnusedFrameworkFile Include="System.Data.Common.dll;System.Private.DataContractSerialization.dll;System.DirectoryServices.dll;Microsoft.CSharp.dll" />
    <UnusedFrameworkFile Include="System.Linq.Parallel.dll;System.Linq.Queryable.dll;System.Security.Cryptography.Pkcs.dll;System.Security.Cryptography.Xml.dll" />
    <UnusedFrameworkFile Include="System.Transactions.Local.dll;System.Net.HttpListener.dll;System.Net.Mail.dll;System.Net.WebSockets.dll" />
    <UnusedFrameworkFile Include="System.Net.WebSockets.Client.dll;System.CodeDom.dll;System.Threading.Tasks.Dataflow.dll;System.Formats.Tar.dll" />
    <UnusedFrameworkFile Include="System.Diagnostics.PerformanceCounter.dll;System.ComponentModel.Annotations.dll;System.Security.Permissions.dll" />
  </ItemGroup>

  <!-- Runs as soon as the SDK has listed the runtime's files, so the files copied and the exe's deps.json both leave them out. -->
  <Target Name="LeaveOutUnusedFrameworkFiles" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <_UnusedFrameworkFile Include="@(UnusedFrameworkFile)" DestinationSubPath="%(Identity)" />
      <RuntimePackAsset Remove="@(_UnusedFrameworkFile)" MatchOnMetadata="DestinationSubPath" MatchOnMetadataOptions="CaseInsensitive" />
      <ReferenceCopyLocalPaths Remove="@(_UnusedFrameworkFile)" MatchOnMetadata="DestinationSubPath" MatchOnMetadataOptions="CaseInsensitive" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Also embedded, so the window and header can show the same icon. LogicalName must match AppIcon. -->
    <EmbeddedResource Include="Assets\ReSkateTrainerUpdater.ico" LogicalName="app.ico" />

    <!-- The background photo, the same one the ReSkate launcher uses. See THIRD-PARTY-NOTICES.md. Delete this line and
         Assets\background.jpg to remove it: the window then falls back to a painted backdrop. LogicalName must match Backdrop. -->
    <EmbeddedResource Include="Assets\background.jpg" LogicalName="background.jpg" />

    <!-- The creator's profile picture, shown on the credit card. LogicalName must match AppImages. -->
    <EmbeddedResource Include="Assets\os_uk.png" LogicalName="profile.png" />

    <!-- The same fonts the ReSkate launcher uses. Licences are in THIRD-PARTY-NOTICES.md. LogicalNames must match GameFonts. -->
    <EmbeddedResource Include="Assets\Fonts\PermanentMarker-Regular.ttf" LogicalName="font.permanentmarker" />
    <EmbeddedResource Include="Assets\Fonts\Montserrat-ExtraBold.ttf" LogicalName="font.montserrat-extrabold" />
    <EmbeddedResource Include="Assets\Fonts\Montserrat-SemiBold.ttf" LogicalName="font.montserrat-semibold" />
  </ItemGroup>

  <!-- Trimming (build-release.ps1 -Trim) takes the exe from about 43 MB to about 26 MB and passes the self-test, but it is OFF
       for releases. Microsoft does not support trimming WinForms, and the trimmer removes methods that managed code never
       calls from COM interfaces, which moves the rest to the wrong vtable slots. That crashed an earlier self-test, and a
       self-test can't call every interface Windows or a screen reader might. See docs/ARCHITECTURE.md. -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <!-- Trimming turns COM interop off by default, and a file dragged in from Explorer arrives as a COM object. Without
         this the window throws a TypeLoadException the moment a zip is dropped on it. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="System.Windows.Forms" />
    <TrimmerRootAssembly Include="System.Windows.Forms.Primitives" />
    <TrimmerRootAssembly Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReSkateTrainerUpdater.Core\ReSkateTrainerUpdater.Core.csproj" />
  </ItemGroup>

</Project>
